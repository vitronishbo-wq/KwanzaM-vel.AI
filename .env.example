# ============================================================
# KWANZAMÓVEL / KMOS
# .env.example
# Production / Sandbox — Angola — 2026
#
# Fluxo:
# Google AI Studio → GitHub → Render → Firebase Hosting
#                                      ↓
#                                   Firestore
#
# IMPORTANTE:
# Este ficheiro é um TEMPLATE.
# Nunca colocar segredos reais no Git.
# Valores sensíveis devem ser configurados no Render /
# GitHub Actions Secrets / Firebase / Google Cloud.
# ============================================================


# ============================================================
# 01. APPLICATION
# ============================================================

NODE_ENV="production"
APP_ENV="production"

APP_NAME="KwanzaMóvel"
APP_VERSION="2.0.0"
KMOS_VERSION="2.0.0"

APP_URL="https://kwanza-movel-ai-sandbox.web.app"
FRONTEND_URL="https://kwanza-movel-ai-sandbox.web.app"

COUNTRY="AO"
DEFAULT_LANGUAGE="pt-AO"
TIMEZONE="Africa/Luanda"

PORT="3000"

BUILD_ENV="production"


# ============================================================
# 02. DEPLOYMENT / RUNTIME
# ============================================================

DEPLOYMENT_PLATFORM="render"
RENDER_ENVIRONMENT="production"

RENDER_EXTERNAL_URL="https://kwanzam-vel-ai.onrender.com"

# Opcional — somente se CI/CD fizer deploy programático.
RENDER_DEPLOY_HOOK=""

# Opcional — somente para automação via API do Render.
RENDER_API_KEY=""
RENDER_SERVICE_ID=""


# ============================================================
# 03. GOOGLE AI STUDIO / GEMINI
# ============================================================

GEMINI_ENABLED="true"

GEMINI_MODEL="gemini-3.7-flash"

GEMINI_PROJECT_NUMBER="753943015323"
GEMINI_PROJECT_ID="753943015323"

# SECRET — preencher somente no ambiente de execução.
GEMINI_API_KEY=""


# ============================================================
# 04. FIREBASE — BACKEND ADMIN SDK
# ============================================================

FIREBASE_ENABLED="true"

FIREBASE_PROJECT_ID="kwanza-movel-ai-sandbox"

FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@kwanza-movel-ai-sandbox.iam.gserviceaccount.com"

FIREBASE_STORAGE_BUCKET="kwanza-movel-ai-sandbox.firebasestorage.app"

# SECRET — Firebase Admin SDK.
# Manter \n dentro da variável.
FIREBASE_PRIVATE_KEY=""


# ============================================================
# 05. FIREBASE HOSTING / VITE FRONTEND
# ============================================================
#
# Estas variáveis são incorporadas pelo Vite no bundle público.
# NÃO tratar VITE_* como segredos.
# ============================================================

VITE_FIREBASE_API_KEY=""

VITE_FIREBASE_PROJECT_ID="kwanza-movel-ai-sandbox"

VITE_FIREBASE_AUTH_DOMAIN="kwanza-movel-ai-sandbox.firebaseapp.com"

VITE_FIREBASE_DATABASE_URL="https://kwanza-movel-ai-sandbox-default-rtdb.firebaseio.com"

VITE_FIREBASE_STORAGE_BUCKET="kwanza-movel-ai-sandbox.firebasestorage.app"

VITE_FIREBASE_MESSAGING_SENDER_ID="414488387152"

VITE_FIREBASE_APP_ID="1:414488387152:web:438ce273cd1f7d381afb55"

VITE_FIREBASE_MEASUREMENT_ID="G-YD74T4BDHB"

VITE_FIREBASE_VAPID_KEY=""


# ============================================================
# 06. FIREBASE AUTHENTICATION / DATABASE
# ============================================================

AUTH_PROVIDER="firebase"
AUTH_REQUIRED="true"

FIREBASE_AUTH_ENABLED="true"

FIREBASE_DATABASE_URL="https://kwanza-movel-ai-sandbox-default-rtdb.firebaseio.com"


# ============================================================
# 07. FIRESTORE
# ============================================================

FIRESTORE_ENABLED="true"

FIRESTORE_DATABASE_ID="(default)"

FIRESTORE_ENVIRONMENT="production"


# ============================================================
# 08. CORS
# ============================================================

CORS_ENABLED="true"

CORS_ORIGINS="https://kwanza-movel-ai-sandbox.web.app"


# ============================================================
# 09. KMOS IDENTITY / RBAC
# ============================================================

KMOS_RBAC_ENABLED="true"

KMOS_ADMIN_AUTH_MODE="RUNTIME"

KMOS_SUPERADMIN_ID="deusfundador"

KMOS_REGULATOR_ID="bna_auditor"


# ============================================================
# 10. KMOS — DEUS FUNDADOR / ADMINISTRATIVE IDENTITY
# ============================================================

KMOS_DEUS_FUNDADOR_EMAIL=""

KMOS_DEUS_FUNDADOR_PHONE=""

KMOS_DEUS_FUNDADOR_NAME=""


# ============================================================
# 11. KMOS CREDENTIALS
# ============================================================
#
# SECRET.
# Não definir valores reais no repositório.
# ============================================================

KMOS_DEFAULT_PASSWORD=""

KMOS_DEFAULT_PIN=""


# ============================================================
# 12. VITE KMOS CREDENTIAL BRIDGE
# ============================================================
#
# ATENÇÃO:
# Tudo que começa por VITE_ pode chegar ao bundle do browser.
# Só usar aqui valores estritamente necessários ao desenho
# atual do CredentialManager.
# ============================================================

VITE_KMOS_DEFAULT_PASSWORD=""

VITE_KMOS_DEUS_FUNDADOR_EMAIL=""

VITE_KMOS_DEUS_FUNDADOR_PHONE=""

VITE_KMOS_DEUS_FUNDADOR_NAME=""


# ============================================================
# 13. ADMIN BOOTSTRAP
# ============================================================

SUPERUSER_EMAIL=""

# SECRET
ADMIN_BOOTSTRAP_SECRET=""


# ============================================================
# 14. CRYPTOGRAPHY / SIGNATURE
# ============================================================

KM_SIGNATURE_MODE="SIMULATED"

KM_PRIV_KEY_REF="projects/kmos/locations/global/keyRings/bna-ring/cryptoKeys/receipt-signer"

# SECRET
KMOS_KMS_SECRET_KEY=""


# ============================================================
# 15. HSM
# ============================================================

HSM_ENABLED="false"

HSM_SERIAL_NUMBER="DEV-HSM-001"

HSM_KEY_SLOT="SIGNING_SLOT_01"

HSM_ALGORITHM="ECDSA_P256_SHA256"

# SECRET
HSM_KMS_SECRET_KEY=""


# ============================================================
# 16. GOOGLE CLOUD KMS
# ============================================================

GOOGLE_KMS_ENABLED="false"

GOOGLE_KMS_PROJECT_ID="kwanza-movel-ai-sandbox"


# ============================================================
# 17. BNA / SPTR
# ============================================================

BNA_SPTR_MODE="SIMULATED"

BNA_SPTR_ENDPOINT="https://sandbox.sptr.local"

BNA_COMPLIANCE_ENABLED="true"

BNA_HOMOLOGATED="false"


# ============================================================
# 18. BNA mTLS
# ============================================================

BNA_MTLS_ENABLED="false"

BNA_MTLS_CERT_PATH=""

BNA_MTLS_KEY_PATH=""

BNA_MTLS_CA_PATH=""


# ============================================================
# 19. SPTR RESILIENCE
# ============================================================

BNA_CIRCUIT_BREAKER_ENABLED="true"

BNA_RETRY_ENABLED="true"

BNA_RETRY_MAX_ATTEMPTS="3"

BNA_RETRY_INITIAL_DELAY_MS="100"

BNA_RETRY_MAX_DELAY_MS="2000"


# ============================================================
# 20. RELATIONAL DATABASE / SQL
# ============================================================
#
# Atualmente desativado.
# Firestore é o datastore configurado.
# ============================================================

DB_ENABLED="false"

SQL_HOST=""

SQL_PORT="5432"

SQL_DB_NAME=""

SQL_USER=""

SQL_PASSWORD=""

SQL_ADMIN_USER=""

SQL_ADMIN_PASSWORD=""


# ============================================================
# 21. OFFLINE-FIRST / LOCAL-FIRST
# ============================================================

OFFLINE_FIRST_ENABLED="true"

LOCAL_PERSISTENCE_ENABLED="true"

FEATURE_OFFLINE_FIRST="true"


# ============================================================
# 22. OBSERVABILITY / TELEMETRY
# ============================================================

OBSERVABILITY_ENABLED="true"

TELEMETRY_ENABLED="true"

AUDIT_LOG_ENABLED="true"

CORRELATION_ID_ENABLED="true"

TRACE_ID_ENABLED="true"

REQUEST_ID_ENABLED="true"

TRANSACTION_ID_ENABLED="true"


# ============================================================
# 23. PERFORMANCE TARGETS
# ============================================================

TARGET_INTERNAL_LATENCY_MS="10"

TARGET_P99_LATENCY_MS="8"


# ============================================================
# 24. SECURITY / ZERO TRUST
# ============================================================

ZERO_TRUST_ENABLED="true"

SECRETS_FROM_ENV="true"

PRODUCTION_CONFIG_STRICT="true"

# Sandbox atual.
# Em produção regulatória real estes valores devem ser revistos.
ALLOW_SIMULATED_BNA="true"

ALLOW_DEV_CREDENTIALS="true"

ALLOW_DEFAULT_PASSWORD="true"


# ============================================================
# 25. FEATURE FLAGS
# ============================================================

FEATURE_BIOMETRIC_AUTH="true"

FEATURE_QR_PAYMENTS="true"

FEATURE_AGENT_NETWORK="true"

FEATURE_VOICE_ASSISTANCE="true"

FEATURE_ACCESSIBILITY="true"


# ============================================================
# 26. PUBLIC / ADMIN SURFACES
# ============================================================

KMOS_PUBLIC_SURFACE="KMPhonePrototype"

KMOS_ADMIN_SURFACE="FinancialOperatingSystem"

# Código canónico definido pela arquitetura.
# Se o código for lido do ambiente pelo runtime,
# preencher no Render e não no repositório.
KMOS_ADMIN_SERVICE_CODE=""


# ============================================================
# 27. REGULATORY
# ============================================================

REGULATORY_MODE="ANGOLA"

BNA_COMPLIANCE_ENABLED="true"

BNA_HOMOLOGATED="false"


# ============================================================
# 28. OPTIONAL PAYMENTS INTEGRATIONS
# ============================================================
#
# Reservado para integrações futuras.
# Não ativar enquanto os adapters não estiverem implementados.
# ============================================================

PROXYPAY_ENABLED="false"

PROXYPAY_API_URL=""

PROXYPAY_API_KEY=""

MULTICAIXA_ENABLED="false"

MULTICAIXA_API_URL=""

MULTICAIXA_CLIENT_ID=""

MULTICAIXA_CLIENT_SECRET=""


# ============================================================
# 29. NOTIFICATIONS / COMMUNICATIONS
# ============================================================

NOTIFICATIONS_ENABLED="true"

SMS_ENABLED="false"

SMS_PROVIDER=""

SMS_API_URL=""

SMS_API_KEY=""

EMAIL_ENABLED="false"

EMAIL_PROVIDER=""

EMAIL_API_URL=""

EMAIL_API_KEY=""


# ============================================================
# 30. RATE LIMITING / API PROTECTION
# ============================================================

RATE_LIMIT_ENABLED="true"

RATE_LIMIT_WINDOW_MS="60000"

RATE_LIMIT_MAX_REQUESTS="300"


# ============================================================
# 31. HTTP / API
# ============================================================

API_PREFIX="/api"

HEALTH_CHECK_ENABLED="true"

READINESS_CHECK_ENABLED="true"

LIVENESS_CHECK_ENABLED="true"


# ============================================================
# 32. IDEMPOTENCY / TRANSACTION SAFETY
# ============================================================

IDEMPOTENCY_ENABLED="true"

OCC_ENABLED="true"

DOUBLE_ENTRY_LEDGER_ENABLED="true"

TRANSACTION_ATOMICITY_ENABLED="true"


# ============================================================
# 33. VERSION / BUILD METADATA
# ============================================================

BUILD_ENV="production"

KMOS_VERSION="2.0.0"

APP_VERSION="2.0.0"