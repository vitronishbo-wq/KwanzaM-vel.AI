# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE CLOUD SQL (POSTGRESQL) CONFIGURATION
# DB_ENABLED: Set to true to enable Postgres database connectivity. If false or unset, the app runs in resilient In-Memory mode.
DB_ENABLED="false"

# SQL_HOST: Path to local Cloud SQL Auth Proxy Unix Socket or DB Server IP/Host
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="kwanzamovel"

# App Access Credentials (Read/Write Data permissions)
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Schema Migration Credentials (Admin/DDL permissions)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# CRYPTOGRAPHIC HSM & KMS CONFIGURATION (FASE 2)
HSM_SERIAL_NUMBER="DEV-HSM-001"
HSM_KEY_SLOT="SIGNING_SLOT_01"
HSM_ALGORITHM="ECDSA_P256_SHA256"
HSM_KMS_SECRET_KEY="DEV_SECRET_KEY"
KM_PRIV_KEY_REF="projects/kmos/keys/receipt-signer"

# BNA SPTR BRIDGE mTLS & CIRCUIT BREAKER CONFIGURATION (FASE 2)
BNA_SPTR_MODE="SIMULATED"
BNA_MTLS_CERT_PATH="./certs/dev/client.crt"
BNA_MTLS_KEY_PATH="./certs/dev/client.key"
BNA_MTLS_CA_PATH="./certs/dev/ca.crt"
BNA_SPTR_ENDPOINT="https://sandbox.sptr.local"

# FIREBASE FIRESTORE ADAPTER CONFIGURATION (FASE 4)
FIREBASE_PROJECT_ID="kwanza-movel-ai-sandbox"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@kwanza-movel-ai-sandbox.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEV_KEY\n-----END PRIVATE KEY-----"

# CREDENTIAL MANAGER CONFIGURATION (FASE 3 / RBAC)
KMOS_DEFAULT_PASSWORD="DeusFundador123!"
KMOS_DEUS_FUNDADOR_EMAIL="ssilajaneiro1@gmail.com"
KMOS_DEUS_FUNDADOR_PHONE="+244 948323383"
KMOS_DEUS_FUNDADOR_NAME="Marcelo Truman"

